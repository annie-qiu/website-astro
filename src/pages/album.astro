---
import Layout from "../layouts/Layout.astro";
import sharp from "sharp";

const ARENA_CHANNEL_SLUG = "photo-blog-hefrs7ul0ta";

// Change this to adjust the default grid column count.
const GRID_COLUMNS = 4;
const COLUMN_CLASSES: Record<number, string> = {
  2: "columns-2",
  3: "columns-3",
  4: "columns-4",
  5: "columns-5",
  6: "columns-6",
};

interface ArenaBlock {
  id: number;
  title: string;
  generated_title: string;
  class: string;
  image?: { display: { url: string } };
}

async function fetchAllArenaImageBlocks(slug: string): Promise<ArenaBlock[]> {
  const perPage = 100;
  const headers: Record<string, string> = import.meta.env.ARENA_API_KEY
    ? { Authorization: `Bearer ${import.meta.env.ARENA_API_KEY}` }
    : {};

  const blocks: ArenaBlock[] = [];
  let page = 1;
  while (true) {
    const res = await fetch(
      `https://api.are.na/v2/channels/${slug}/contents?page=${page}&per=${perPage}`,
      { headers }
    );
    const data: { contents?: ArenaBlock[] } = await res.json();
    const pageBlocks = data.contents ?? [];
    blocks.push(...pageBlocks);
    if (pageBlocks.length < perPage) break;
    page++;
  }
  return blocks;
}

function rgbToHslHex(r: number, g: number, b: number): { hue: number; lightness: number; hex: string } {
  const [rf, gf, bf] = [r / 255, g / 255, b / 255];
  const max = Math.max(rf, gf, bf);
  const min = Math.min(rf, gf, bf);
  const lightness = (max + min) / 2;

  let hue = 0;
  if (max !== min) {
    const d = max - min;
    switch (max) {
      case rf:
        hue = ((gf - bf) / d + (gf < bf ? 6 : 0)) * 60;
        break;
      case gf:
        hue = ((bf - rf) / d + 2) * 60;
        break;
      case bf:
        hue = ((rf - gf) / d + 4) * 60;
        break;
    }
  }

  const hex = `#${[r, g, b].map((c) => c.toString(16).padStart(2, "0")).join("")}`;
  return { hue, lightness, hex };
}

// Finds the most frequently occurring color (quantized into a coarse RGB
// grid) rather than the mathematical mean, which tends to wash busy photos
// out into a muddy average.
async function getDominantColor(url: string): Promise<{ hue: number; lightness: number; hex: string }> {
  const res = await fetch(url);
  const buf = Buffer.from(await res.arrayBuffer());
  const { data } = await sharp(buf)
    .resize(50, 50, { fit: "fill" })
    .removeAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  const buckets = new Map<string, { count: number; rSum: number; gSum: number; bSum: number }>();

  for (let i = 0; i < data.length; i += 3) {
    const r = data[i];
    const g = data[i + 1];
    const b = data[i + 2];
    // >> 5 quantizes each channel into 8 buckets (256 / 32)
    const key = `${r >> 5}-${g >> 5}-${b >> 5}`;
    const bucket = buckets.get(key) ?? { count: 0, rSum: 0, gSum: 0, bSum: 0 };
    bucket.count++;
    bucket.rSum += r;
    bucket.gSum += g;
    bucket.bSum += b;
    buckets.set(key, bucket);
  }

  let dominant = { count: 0, rSum: 0, gSum: 0, bSum: 0 };
  for (const bucket of buckets.values()) {
    if (bucket.count > dominant.count) dominant = bucket;
  }

  return rgbToHslHex(
    Math.round(dominant.rSum / dominant.count),
    Math.round(dominant.gSum / dominant.count),
    Math.round(dominant.bSum / dominant.count)
  );
}

const blocks = await fetchAllArenaImageBlocks(ARENA_CHANNEL_SLUG);

const images = await Promise.all(
  blocks
    .filter((block) => block.class === "Image" && block.image)
    .map(async (block) => {
      const url = block.image!.display.url;
      const { hue, lightness, hex } = await getDominantColor(url);
      return {
        id: block.id,
        url,
        title: block.generated_title,
        hue,
        lightness,
        color: hex,
      };
    })
);
---

<Layout title="photos">
  <div><a class="" href="/">← home</a></div>
  <br>
  <div class="text-base mt-2 mb-4 text-center">photo blog</div>
  <div class="flex flex-wrap gap-x-3 gap-y-2 justify-center items-center mb-4 text-xs sans-serif text-gray-500">
    <button type="button" data-view="blog" class="hover:text-gray-800 text-gray-400">
      1
    </button>
    {Object.keys(COLUMN_CLASSES).map((n) => (
      <button
        type="button"
        data-view={n}
        class:list={[
          "hover:text-gray-800",
          Number(n) === GRID_COLUMNS ? "text-gray-800" : "text-gray-400",
          Number(n) >= 4 ? "hidden sm:inline-block" : "",
        ]}
      >
        {n}
      </button>
    ))}
    <span class="text-gray-300">|</span>
    <button type="button" id="shuffle-button" class="text-gray-500 hover:text-gray-800">
      shuffle
    </button>
    <span class="text-gray-300">|</span>
    <span class="text-gray-400 whitespace-nowrap">sort by</span>
    <button type="button" id="sort-hue-button" class="text-gray-500 hover:text-gray-800">
      hue
    </button>
    <span class="text-gray-300">/</span>
    <button type="button" id="sort-brightness-button" class="text-gray-500 hover:text-gray-800">
      brightness
    </button>
    <span class="text-gray-300">/</span>
    <button type="button" id="sort-alpha-button" class="text-gray-500 hover:text-gray-800">
      a-z
    </button>
  </div>
  <br>
  <div id="photo-grid" class:list={["container", COLUMN_CLASSES[GRID_COLUMNS], "max-w-[80em] m-auto gap-4 lg:gap-8"]}>
    {images.map((image) => (
      <div class="photo-item mb-4 lg:mb-8 container" data-caption={image.title || undefined} data-hue={image.hue} data-lightness={image.lightness} data-color={image.color}>
        <img src={image.url} alt={image.title || "photo"} class="photo-img w-full" loading="lazy" />
        <div class="photo-caption hidden items-center gap-2 text-xs text-gray-600">
          <span class="photo-swatch inline-block w-2 h-2 flex-shrink-0 rounded-sm" style={`background-color: ${image.color}`}></span>
          {image.title && <span>{image.title}</span>}
        </div>
      </div>
    ))}
  </div>
  <div id="image-tooltip" class="fixed z-50 hidden flex items-center gap-2 pointer-events-none max-w-[16rem] bg-white px-2 py-1 text-xs text-gray-600 shadow-md">
    <span id="tooltip-text"></span>
  </div>
</Layout>

<script>
  const tooltip = document.getElementById("image-tooltip");
  const tooltipText = document.getElementById("tooltip-text");
  const grid = document.getElementById("photo-grid");
  const viewButtons = document.querySelectorAll<HTMLButtonElement>("[data-view]");

  let currentView = grid ? (Array.from(grid.classList).find((c) => /^columns-\d+$/.test(c))?.replace("columns-", "") ?? "4") : "4";

  function gridClassName(view: string): string {
    if (view === "blog") return "flex flex-col gap-4 lg:gap-8 max-w-xl m-auto";
    const maxWidth = view === "2" ? "max-w-3xl" : view === "6" ? "max-w-4xl" : "max-w-[80em]";
    return `container columns-${view} ${maxWidth} m-auto gap-4 lg:gap-8`;
  }

  function applyItemClasses(item: HTMLElement, view: string) {
    const img = item.querySelector<HTMLImageElement>(".photo-img");
    const caption = item.querySelector<HTMLElement>(".photo-caption");
    const swatch = item.querySelector<HTMLElement>(".photo-swatch");
    if (view === "blog") {
      item.className = "photo-item flex items-center gap-3";
      if (img) img.className = "photo-img w-16 h-16 object-cover flex-shrink-0";
      if (caption) caption.className = "photo-caption flex items-center gap-2 text-sm";
      if (swatch) swatch.className = "photo-swatch hidden";
    } else {
      item.className = "photo-item mb-4 lg:mb-8 container";
      if (img) img.className = view === "6" ? "photo-img w-full aspect-square object-cover" : "photo-img w-full";
      if (caption) caption.className = "photo-caption hidden";
      if (swatch) swatch.className = "photo-swatch inline-block w-2 h-2 flex-shrink-0 rounded-sm";
    }
  }

  function setView(view: string) {
    if (!grid) return;
    currentView = view;
    grid.className = gridClassName(view);
    Array.from(grid.children).forEach((item) => applyItemClasses(item as HTMLElement, view));

    viewButtons.forEach((button) => {
      const isActive = button.dataset.view === view;
      button.classList.toggle("text-gray-800", isActive);
      button.classList.toggle("text-gray-400", !isActive);
    });
  }

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => setView(button.dataset.view!));
  });

  function shuffleGrid() {
    if (!grid) return;
    const items = Array.from(grid.children);
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.forEach((item) => grid.appendChild(item));
  }

  document.getElementById("shuffle-button")?.addEventListener("click", shuffleGrid);
  shuffleGrid();

  document.getElementById("sort-hue-button")?.addEventListener("click", () => {
    if (!grid) return;
    const items = Array.from(grid.children) as HTMLElement[];
    items.sort((a, b) => Number(a.dataset.hue) - Number(b.dataset.hue));
    items.forEach((item) => grid.appendChild(item));
  });

  document.getElementById("sort-brightness-button")?.addEventListener("click", () => {
    if (!grid) return;
    const items = Array.from(grid.children) as HTMLElement[];
    items.sort((a, b) => Number(a.dataset.lightness) - Number(b.dataset.lightness));
    items.forEach((item) => grid.appendChild(item));
  });

  document.getElementById("sort-alpha-button")?.addEventListener("click", () => {
    if (!grid) return;
    const items = Array.from(grid.children) as HTMLElement[];
    items.sort((a, b) => (a.dataset.caption ?? "").localeCompare(b.dataset.caption ?? ""));
    items.forEach((item) => grid.appendChild(item));
  });

  document.querySelectorAll<HTMLElement>("[data-caption]").forEach((el) => {
    el.addEventListener("mouseenter", () => {
      if (currentView === "blog" || !tooltip || !el.dataset.caption) return;
      if (tooltipText) tooltipText.textContent = el.dataset.caption;
      tooltip.classList.remove("hidden");
    });
    el.addEventListener("mousemove", (e: MouseEvent) => {
      if (!tooltip) return;
      tooltip.style.left = `${e.clientX + 12}px`;
      tooltip.style.top = `${e.clientY + 12}px`;
    });
    el.addEventListener("mouseleave", () => {
      tooltip?.classList.add("hidden");
    });
  });
</script>
