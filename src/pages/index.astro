---
import "../styles/global.scss";
import Layout from "../layouts/Layout.astro";
import LeftPanel from "../components/LeftPanel.astro";
import WorkPanel from "../components/WorkPanel.astro";
import { getCollection } from "astro:content";
import paintingCover from "../assets/paintings/lizard.jpg";
import { Image } from "astro:assets";


const paintings = await getCollection("paintings");
const projectEntries = await getCollection(
  "projects",
  ({ data }) => !data.archive,
);

const projects = await Promise.all(
  projectEntries.map(async (entry) => {
    const { Content } = await entry.render(); // use entry.render() instead if on Astro 4.x
    return {
      title: entry.data.title,
      description: entry.data.description,
      images: entry.data.images,
      detail: Content,
      video: entry.data.video,
      slug: entry.slug,
      link: entry.data.link,
    };
  }),
);
---

<Layout title={"Annie Qiu"}>
  <div class="flex flex-col lg:flex-row gap-16 lg:gap-8 lg:items-start">
    <LeftPanel />
    <div class="w-full lg:flex-1 lg:flex lg:flex-col lg:min-h-[calc(100vh-3rem)]">
      <WorkPanel
        id="paintings"
        title="paintings"
        layout="masonry"
        lightbox
        items={paintings.map((p) => ({
          id: p.id,
          image: p.data.image,
          title: p.data.title,
          label: `${p.data.year}, ${p.data.text}`,
          href: `/paintings/${p.id}`,
        }))}
      />
      <WorkPanel id="software" title="software">
        <p class="text-sm leading-normal max-w-2xl indent-8">
          I currently work as a Forward Deployed Engineer on the commercial side
          at Palantir, where I build systems for enterprise workflows, including a
          probabilistic forecasting tool for a software and hardware manufacturer
          and an LLM-based RFP automation tool for a Fortune 500 company. Before
          that, I interned at Databricks and worked on supporting a cost-optimized
          mode for Serverless Compute using spot instances.
        </p>
      </WorkPanel>
      <WorkPanel
        id="design"
        title="design"
        layout="design"
        projects={projects}
        ;
      />
      <div id="about" class="work-panel w-full lg:max-h-[calc(100vh-3rem)] lg:overflow-hidden" data-work-panel hidden>
        <div class="flex flex-col gap-2 lg:h-full">
          <p class="text-sm">I grew up in Shanghai, studied computer science and studio art at Dartmouth, and live in New York City. </p>
          <Image
            src={paintingCover}
            alt="Lizard Apartment"
            class="w-full h-auto object-cover lg:flex-1 lg:min-h-0 lg:w-auto lg:h-full lg:object-contain"
          />
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const categories = document.querySelectorAll<HTMLElement>(".category");
  const panels = document.querySelectorAll<HTMLElement>("[data-work-panel]");

  function showPanel(id: string) {
    panels.forEach((panel) => {
      panel.hidden = panel.id !== id;
    });

    categories.forEach((category) => {
      const selected = category.dataset.target === id;
      category.classList.toggle("decoration-solid", selected);
      category.classList.toggle("decoration-dotted", !selected);
    });
  }

  function goToHash(hash: string) {
    const [id, slug] = hash.split("/");
    showPanel(id || "about");
    if (slug) {
      requestAnimationFrame(() => {
        document.getElementById(slug)?.scrollIntoView();
      });
    }
  }

  categories.forEach((category) => {
    category.addEventListener("click", (e) => {
      e.preventDefault();
      const target = category.dataset.target!;
      showPanel(target);
      history.pushState(null, "", `#${target}`);
    });
  });

  window.addEventListener("popstate", () => {
    goToHash(window.location.hash.slice(1) || "about");
  });

  goToHash(window.location.hash.slice(1) || "about");
</script>
