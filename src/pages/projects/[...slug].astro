---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LeftPanel from '../../components/LeftPanel.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug }, props: { project },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { project } = Astro.props;
const { Content } = await project.render();
---
<Layout title={project.data.title}>
  <div class="flex flex-col lg:flex-row gap-16 lg:gap-8 lg:items-start">
    <div class="hidden lg:contents">
      <LeftPanel />
    </div>
    <div class="w-full lg:flex-1 max-w-4xl">
      <p class="text-sm">
        <a href={`/#design/${project.slug}`} class="link">← back</a>
      </p>
      <div class="mt-6">
        <p class="text-md mb-2">{project.data.title}</p>
        <p class="text-xs sans-serif text-gray-400 font-weight-300">{project.data.description}</p>
        <div class="text-[0.8125rem] text-gray-500 leading-snug mt-4">
          <Content />
        </div>
        {project.data.video && (
          <div class="aspect-video mt-4">
            <iframe
              src={`https://player.vimeo.com/video/${project.data.video}`}
              class="w-full h-full"
              allow="autoplay; fullscreen; picture-in-picture"
              loading="lazy"
            ></iframe>
          </div>
        )}
        {project.data.additionalImages?.length && (
          project.data.additionalImagesLayout === "masonry" ? (
            <div class="columns-2 gap-4 mt-8">
              {project.data.additionalImages.map((img) => (
                <Image src={img} alt={project.data.title} class="w-full h-auto break-inside-avoid mb-4" />
              ))}
            </div>
          ) : (
            <div class="flex flex-col gap-6 mt-8">
              {project.data.additionalImages.map((img) => (
                <Image src={img} alt={project.data.title} class="w-full h-auto" />
              ))}
            </div>
          )
        )}
      </div>
    </div>
  </div>
</Layout>
