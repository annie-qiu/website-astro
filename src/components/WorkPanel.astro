---
import { Image } from "astro:assets";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface GridItem {
  href?: string;
  title: string;
  label: string;
  image?: ImageMetadata;
  id?: string;
}

interface Project {
  title: string;
  description: string;
  images?: ImageMetadata[];
  detail: AstroComponentFactory;
  video?: string;
  slug: string;
  link?: boolean;
}

interface Props {
  id: string;
  title: string;
  layout?: "grid" | "design" | "list" | "masonry";
  items?: GridItem[];
  projects?: Project[];
  class?: string;
  lightbox?: boolean;
}

const { id, title: _title, layout = "grid", items, projects, class: className, lightbox = false } = Astro.props as Props;
---

<div id={id} class:list={["work-panel w-full lg:max-w-6xl", className]} data-work-panel hidden>

  {layout === "grid" && items?.length && (
    <div class="grid gap-3">
      {items.map((item) => (
        <a href={item.href} class="block group">
          {item.image && (
            <Image
              src={item.image}
              alt={item.label}
              class="w-full h-auto object-cover transition-opacity group-hover:opacity-70"
            />
          )}
          <p class="text-xs mt-1 text-gray-500">{item.label}</p>
        </a>
      ))}
    </div>
  )}

  {layout === "masonry" && items?.length && (
    <div data-lightbox-grid class="columns-1 sm:columns-2 gap-4 sm:gap-8">
      {items.map((item) => (
        <a
          href={item.href}
          class="block break-inside-avoid mb-4 sm:mb-8 group"
          data-lightbox-open={lightbox && item.id ? item.id : undefined}
        >
          {item.image && (
            <Image
              src={item.image}
              alt={item.label}
              class="w-full h-auto transition-opacity group-hover:opacity-70"
            />
          )}
        </a>
      ))}
    </div>
  )}

  {layout === "masonry" && lightbox && items?.length && (
    <div data-lightbox-root data-panel-id={id} class="hidden">
      <div class="flex items-center justify-between text-xs text-gray-600 mb-4">
        <button type="button" data-lightbox-close class="link">show all</button>
        <div class="flex gap-4">
          <button type="button" data-lightbox-prev class="hover:text-gray-800">&larr; prev</button>
          <button type="button" data-lightbox-next class="hover:text-gray-800">next &rarr;</button>
        </div>
      </div>
      {items.map((item) => item.id && (
        <div data-lightbox-slide={item.id} class="hidden flex flex-col gap-2">
          {item.image && (
            <Image
              src={item.image}
              alt={item.label}
              class="w-full max-h-[80vh] object-contain"
            />
          )}
          <div class="flex flex-col gap-0">
            <p class="text-sm text-gray-600 mb-0">{item.title}</p>
            <p class="text-xs sans-serif text-gray-400 mb-0">{item.label}</p>
          </div>
        </div>
      ))}
    </div>
  )}

  {layout === "list" && items?.length && (
    <ul>
      {items.map((item) => (
        <li class="py-2 text-xs">
          {item.image && <Image class="mb-2" src={item.image} alt={item.label} />}
          <p>
            <span class="text-sm text-gray-600">{item.title}, </span><span class="sans-serif text-xs text-gray-400">{item.label}</span>
          </p>
        </li>
      ))}
    </ul>
  )}

  {layout === "design" && projects?.length && (
    <div class="space-y-12">
      {projects.map((project) => {
        const Detail = project.detail;
        return (
          <div id={project.slug} class="grid grid-cols-1 gap-6 scroll-mt-6">
            <div>
              {project.link ? (
                <p class="text-md mb-2">
                <a href={`/projects/${project.slug}`} class="link">{project.title}</a>
                </p>
              ) : (
                <p class="text-md mb-2">{project.title}</p>
              )}
              <p class="text-xs sans-serif text-gray-400 font-weight-300">{project.description}</p>
              <div class="text-[0.8125rem] text-gray-500 leading-snug">
                <Detail />
              </div>
            </div>
            <div>
              {project.video && (
              <div class="aspect-video mb-3">
                <iframe
                  src={`https://player.vimeo.com/video/${project.video}`}
                  class="w-full h-full"
                  allow="autoplay; fullscreen; picture-in-picture"
                  loading="lazy"
                ></iframe>
              </div>
            )}
              <div class="flex-row gap-2 s">
                {project.images?.length &&  project.images.map((img) => (
                  <Image src={img} alt={project.title} class="w-full max-h-[80vh] object-contain object-left mb-6" />
                ))}
              </div>

            </div>
          </div>
        );
      })}
    </div>
  )}

  {!items?.length && !projects?.length && <slot />}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-lightbox-root]").forEach((root) => {
    const panelId = root.dataset.panelId!;
    const panel = root.closest<HTMLElement>("[data-work-panel]");
    const grid = panel?.querySelector<HTMLElement>("[data-lightbox-grid]");
    const slides = root.querySelectorAll<HTMLElement>("[data-lightbox-slide]");

    const leftPanel = document.getElementById("left-panel");

    function open(itemId: string) {
      let matched = false;
      slides.forEach((slide) => {
        const isMatch = slide.dataset.lightboxSlide === itemId;
        slide.classList.toggle("hidden", !isMatch);
        if (isMatch) matched = true;
      });
      if (!matched) return;
      grid?.classList.add("hidden");
      root.classList.remove("hidden");
      leftPanel?.classList.add("hidden", "lg:flex");
    }

    function close() {
      root.classList.add("hidden");
      grid?.classList.remove("hidden");
      leftPanel?.classList.remove("hidden", "lg:flex");
    }

    function currentIndex() {
      return Array.from(slides).findIndex((slide) => !slide.classList.contains("hidden"));
    }

    function openByOffset(offset: number) {
      const total = slides.length;
      if (!total) return;
      const nextIndex = ((currentIndex() + offset) % total + total) % total;
      const itemId = slides[nextIndex].dataset.lightboxSlide;
      if (!itemId) return;
      open(itemId);
      history.pushState(null, "", `#${panelId}/${itemId}`);
    }

    root.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => openByOffset(-1));
    root.querySelector("[data-lightbox-next]")?.addEventListener("click", () => openByOffset(1));

    document.addEventListener("keydown", (e) => {
      if (root.classList.contains("hidden")) return;
      if (e.key === "ArrowLeft") openByOffset(-1);
      if (e.key === "ArrowRight") openByOffset(1);
    });

    root.querySelector("[data-lightbox-close]")?.addEventListener("click", () => {
      close();
      history.pushState(null, "", `#${panelId}`);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !root.classList.contains("hidden")) {
        close();
        history.pushState(null, "", `#${panelId}`);
      }
    });

    document.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((trigger) => {
      if (trigger.closest("[data-work-panel]")?.id !== panelId) return;
      trigger.addEventListener("click", (e: MouseEvent) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const itemId = trigger.dataset.lightboxOpen;
        if (!itemId) return;
        e.preventDefault();
        open(itemId);
        history.pushState(null, "", `#${panelId}/${itemId}`);
      });
    });

    function syncFromHash() {
      const [hashPanel, hashItem] = window.location.hash.slice(1).split("/");
      if (hashPanel === panelId && hashItem) {
        open(hashItem);
      } else {
        close();
      }
    }

    window.addEventListener("popstate", syncFromHash);
    syncFromHash();
  });
</script>